# Copie para .env.local (local) e cadastre as mesmas chaves na Vercel.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Login do painel. Em producao, defina SEMPRE (vazio = painel aberto). ---
PANEL_PASSWORD=

# --- Protege /api/collect. Um texto aleatorio longo. A Vercel manda sozinha
#     no cron; o GitHub Actions manda via secret. ---
CRON_SECRET=

# --- Telegram (conta de usuario, numero DEDICADO). ---
# api_id/api_hash: https://my.telegram.org > API development tools
# TG_SESSION: gerada por `npm run tg:login` (trate como senha)
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# --- Anthropic (categorizacao dos posts). Sem ela, coleta mas nao categoriza. ---
ANTHROPIC_API_KEY=
